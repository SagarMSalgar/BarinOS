# BrainOS — set these for your environment. No hardcoded secrets in code.

# LLM: set BRAINOS_LLM_PROVIDER=gemini to use Gemini; otherwise openai/anthropic from config
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# BRAINOS_LLM_PROVIDER=gemini
# Gemini (when BRAINOS_LLM_PROVIDER=gemini)
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Vector store (optional: in-memory used if not set)
PINECONE_INDEX=
PINECONE_API_KEY=

# Database (optional: in-memory registry used if not set)
DATABASE_URL=

# Backend config directory (default: backend/config)
# BRAINOS_CONFIG_DIR=

# Frontend API URL (for Next.js)
# NEXT_PUBLIC_API_URL=http://localhost:8000
